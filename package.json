{
  "name": "pi-codemode-mcp",
  "version": "0.2.0",
  "description": "Pi extension exposing MCP through a local confined CodeMode runtime",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "pi-package",
    "pi",
    "mcp",
    "codemode",
    "extension"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "files": [
    "src",
    "nono",
    "scripts",
    "test",
    "README.md",
    "tsconfig.json",
    "tsconfig.build.json"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "proof:nono:outer": "scripts/nono/prove-outer.sh",
    "proof:nono:servers": "scripts/nono/prove-per-server.sh",
    "proof:nono": "npm run proof:nono:outer && npm run proof:nono:servers"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.25.1",
    "acorn": "8.15.0",
    "effect": "4.0.0-beta.83",
    "typebox": "^1.3.7",
    "typescript": "^5.9.2"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.84.4",
    "@earendil-works/pi-tui": "^0.84.4",
    "@types/node": "^22.15.0",
    "vitest": "^4.1.11"
  }
}
